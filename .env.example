# procbot environment. Copy to .env and fill in. Never commit .env.
# Подробно: docs/deploy.md

# --- required -------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user id of the only owner (e.g. from @userinfobot)
OWNER_TELEGRAM_ID=
# Fernet key that encrypts secrets in the DB and the backups:
#   docker compose run --rm procbot gen-key    or    uv run procbot gen-key
# Keep a copy OUTSIDE the server: without it backups cannot be restored.
MASTER_KEY=

# --- paths (defaults are fine for local runs; Docker overrides them) ----------
DATABASE_PATH=data/procbot.db
LOCK_PATH=data/procbot.lock
BACKUP_DIR=backups
APP_CONFIG_PATH=config/app.yaml
AI_CONFIG_PATH=config/ai.yaml
LOG_LEVEL=INFO

# --- HTTP (/healthz; Mini App API in stage D) ------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
MINIAPP_PUBLIC_URL=

# --- Google Calendar (stage C; empty = integration off) -------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- AI providers (stage B; referenced by config/ai.yaml, empty = no AI) ----------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
